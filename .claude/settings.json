{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/ecc-guards.js\" pre-bash" }] },
      { "matcher": "Write", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/ecc-guards.js\" pre-write" }] },
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/suggest-compact.js\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/ecc-guards.js\" post-bash" }] },
      { "matcher": "Edit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/ecc-guards.js\" post-edit" }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/pre-compact.js\"" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/session-start.js\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/ecc-guards.js\" stop" }] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/session-end.js\"" },
        { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/hooks/evaluate-session.js\"" }
      ] }
    ]
  }
}
